{
  "name": "muthbit-platform",
  "private": true,
  "version": "0.1.0",
  "description": "منصة مثبت — منصة مشتريات موثّقة للشركات",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "api:dev": "npm run dev --workspace @muthbit/api",
    "api:migrate": "npm run migrate --workspace @muthbit/api",
    "api:rollback": "npm run rollback --workspace @muthbit/api",
    "api:seed": "npm run seed --workspace @muthbit/api",
    "api:test": "npm run test --workspace @muthbit/api",
    "web:dev": "npm run dev --workspace @muthbit/web",
    "web:build": "npm run build --workspace @muthbit/web"
  }
}
