# ---- قاعدة البيانات ----
DATABASE_URL=postgres://muthbit:muthbit_dev@127.0.0.1:5432/muthbit_dev
PGSSL=false

# ---- المصادقة ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- الخادم ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- التوثيق الحكومي (المرحلة الثالثة) ----
# واثق — التحقق من السجل التجاري. اتركه فارغاً ليعمل النظام بالتحقق اليدوي.
WATHQ_API_KEY=
WATHQ_BASE_URL=https://api.wathq.sa

# ---- تتبع الأخطاء ----
SENTRY_DSN=

# ---- البريد (رابط إعادة تعيين كلمة المرور) ----
# console: يطبع الرسالة والرابط في الطرفية ولا يرسل — الافتراضي في التطوير.
# resend: يرسل فعلاً عبر Resend، ويحتاج المتغيّرين تحته. في الإنتاج لا يُرسل شيء بغيره،
# و console محجوب هناك لأنه يكتب رموز إعادة التعيين في سجلات الخادم.
# بيئة الاختبار لا ترسل أبداً أياً كانت القيمة.
MAIL_DRIVER=console
RESEND_API_KEY=
# عنوان مُرسِل من نطاق موثَّق في Resend، مثل: مثبت <no-reply@example.sa>
MAIL_FROM=
# عنوان الواجهة الذي يُبنى منه الرابط في البريد. إن غاب فهو CORS_ORIGIN.
APP_URL=
